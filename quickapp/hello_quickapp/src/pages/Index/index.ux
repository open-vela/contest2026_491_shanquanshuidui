<template>
  <div class="container">
    <!-- =================== 页1：主页 =================== -->
    <div class="page page-home" if="{{currentPage === 0}}">
      <div class="header">
        <text class="time">{{timeStr}}</text>
        <text class="date">{{dateStr}}</text>
      </div>
      <div class="metrics-row">
        <div class="metric-card" onclick="onTapMetric('hr')">
          <text class="metric-icon hr-icon">HR</text>
          <text class="metric-value">{{hr}}</text>
          <text class="metric-label">心率</text>
          <text class="metric-unit">bpm</text>
        </div>
        <div class="metric-card" onclick="onTapMetric('spo2')">
          <text class="metric-icon spo2-icon">SpO2</text>
          <text class="metric-value">{{spo2}}%</text>
          <text class="metric-label">血氧</text>
          <text class="metric-unit">饱和度</text>
        </div>
        <div class="metric-card" onclick="onTapMetric('stress')">
          <text class="metric-icon stress-icon">ST</text>
          <text class="metric-value">{{stress}}</text>
          <text class="metric-label">压力</text>
          <text class="metric-unit">等级</text>
        </div>
      </div>
      <div class="es3-bar">
        <text class="es3-value">{{es3}}</text>
        <text class="es3-label">ES3 波动</text>
      </div>
      <div class="nav-bar">
        <div class="nav-btn nav-up" onclick="goNext" if="{{currentPage < 4}}">
          <text class="nav-arrow">^</text>
        </div>
      </div>
    </div>

    <!-- =================== 页2：AI对话 =================== -->
    <div class="page page-chat" if="{{currentPage === 1}}">
      <div class="chat-header">
        <text class="chat-title">对话</text>
        <text class="chat-es3">ES3 波动 {{es3}}</text>
      </div>
      <div class="chat-body">
        <div class="chat-msg-list">
          <div class="chat-msg-row {{$item.role === 'user' ? 'msg-row-user' : 'msg-row-ai'}}" for="{{chatMessages}}">
            <text class="chat-msg-text {{$item.role === 'user' ? 'msg-text-user' : 'msg-text-ai'}}">{{$item.text}}</text>
          </div>
          <div class="chat-thinking" if="{{isAiThinking}}">
            <text class="chat-thinking-text">AI 思考中...</text>
          </div>
        </div>
      </div>
      <div class="chat-input-bar">
        <div class="chat-mic-btn" onclick="onVoiceInput">
          <text class="chat-mic-icon">MIC</text>
        </div>
        <div class="chat-input" onclick="onInputFocus">
          <text class="chat-input-text" if="{{inputText}}">{{inputText}}</text>
          <text class="chat-input-text chat-placeholder" else>输入想说的话...</text>
        </div>
        <div class="chat-send-btn" onclick="onSendMsg">
          <text class="chat-send-icon">-></text>
        </div>
      </div>
      <div class="nav-bar">
        <div class="nav-btn nav-down" onclick="goPrev">
          <text class="nav-arrow">v</text>
        </div>
        <div class="nav-btn nav-up" onclick="goNext">
          <text class="nav-arrow">^</text>
        </div>
      </div>
    </div>

    <!-- =================== 页3：历史记录 =================== -->
    <div class="page page-history" if="{{currentPage === 2}}">
      <text class="page-title">历史</text>
      <div class="history-list" if="{{historyList.length > 0}}">
        <div class="history-item" for="{{historyList}}" onclick="onTapHistory($idx)">
          <text class="history-date">{{$item.date}}</text>
          <text class="history-summary">{{$item.summary}}</text>
        </div>
      </div>
      <div class="empty-state" else>
        <text class="empty-icon">[ ]</text>
        <text class="empty-text">这一天还没有对话记录</text>
      </div>
      <div class="nav-bar">
        <div class="nav-btn nav-down" onclick="goPrev">
          <text class="nav-arrow">v</text>
        </div>
        <div class="nav-btn nav-up" onclick="goNext">
          <text class="nav-arrow">^</text>
        </div>
      </div>
    </div>

    <!-- =================== 页4：播客访谈 =================== -->
    <div class="page page-podcast" if="{{currentPage === 3}}">
      <text class="page-title">播客访谈</text>
      <div class="podcast-card" if="{{podcastText}}">
        <div class="podcast-card-header">
          <text class="podcast-date">播客访谈 {{podcastDate}}</text>
          <div class="podcast-play-btn" onclick="onPlayPodcast">
            <text class="podcast-play-text">{{isPlaying ? 'STOP' : 'PLAY'}}</text>
          </div>
          <div class="podcast-del-btn" onclick="onDeletePodcast">
            <text class="podcast-del-icon">X</text>
          </div>
        </div>
        <text class="podcast-text">{{podcastText}}</text>
      </div>
      <div class="empty-state" else>
        <text class="empty-text">还没有对话，去对话页聊聊，再回来选日期和话题生成播客</text>
      </div>
      <div class="nav-bar">
        <div class="nav-btn nav-down" onclick="goPrev">
          <text class="nav-arrow">v</text>
        </div>
        <div class="nav-btn nav-up" onclick="goNext">
          <text class="nav-arrow">^</text>
        </div>
      </div>
    </div>

    <!-- =================== 页5：趋势 =================== -->
    <div class="page page-trends" if="{{currentPage === 4}}">
      <text class="page-title">趋势</text>
      <div class="trends-tabs">
        <text class="tab {{activeTab==='hr' ? 'tab-active' : ''}}" onclick="onSwitchTab('hr')">心率</text>
        <text class="tab {{activeTab==='stress' ? 'tab-active' : ''}}" onclick="onSwitchTab('stress')">压力</text>
        <text class="tab {{activeTab==='spo2' ? 'tab-active' : ''}}" onclick="onSwitchTab('spo2')">血氧</text>
      </div>
      <div class="chart-area">
        <div class="bar-row" for="{{chartData}}">
          <div class="bar test-bar">
          </div>
          <text class="bar-label">{{$item.date}}</text>
        </div>
      </div>
      <div class="stats-row">
        <div class="stat-card">
          <text class="stat-label">Min</text>
