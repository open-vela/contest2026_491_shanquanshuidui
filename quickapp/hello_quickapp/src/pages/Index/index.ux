<script>
import health from "@service.health";
import velaclaw from "@system.velaclaw";
import storage from "@system.storage";

export default {
  data: {
    // 通用
    currentPage: 0,
    timeStr: '14:53:43',
    dateStr: '2026年9月14日 周一',
    es3: 65,
    lastEs3Level: 0,
    lastVibrateTime: 0,

    // 页1：健康指标
    hr: 73,
    spo2: 97,
    stress: 37,

    // 页2：对话
    chatMessages: [],
    userMsg: '',
    inputText: '',
    isAiThinking: false,
    autoConvIndex: 0,
    autoConvActive: false,
    autoConvSeq: [
      '我今天心情不太好，感觉压力有点大',
      '我的心率73，血氧97，压力37，你觉得我的状态怎么样？',
      '有什么建议可以帮我放松一下吗？',
    ],

    // 页3：历史
    historyList: [],

    // 页4：播客
    podcastText: '嗨，大家好，欢迎回到我们的心理小电台，我是你们的主播。这一周我们看着数据起起伏伏，就像坐了一趟情绪过山车。9月10号那天压力飙到57，情绪跌到41分，而到了9月9号和11号，你又恢复了活力，情绪冲上70多分。这种波动其实特别正常，说明你的身心在努力自我调节。',
    podcastDate: '今天 周日 23:11',
    isPlaying: false,

    // 页5：趋势
    activeTab: 'hr',
    chartData: [
      { date: '09-11', height: 78, barClass: 'bar-h78' },
      { date: '09-12', height: 82, barClass: 'bar-h82' },
      { date: '09-13', height: 71, barClass: 'bar-h71' },
      { date: '09-14', height: 88, barClass: 'bar-h88' },
      { date: '09-15', height: 75, barClass: 'bar-h75' },
      { date: '09-16', height: 80, barClass: 'bar-h80' },
      { date: '09-17', height: 73, barClass: 'bar-h73' },
    ],
    stats: { min: '71bpm', max: '88bpm', avg: '78.1bpm' },
    // 30天历史数据（内置模拟数据，确保首次运行即可显示趋势图）
    historyData: {
      hr: [],
      spo2: [],
      stress: [],
    },
  },

  onReady() {
    this.updateTime();
    this.timer = setInterval(() => this.updateTime(), 1000);
    this.getRecentHealth();
    this.subscribeHealth();
  },

  // 启动自动对话序列
  startAutoConversation() {
    this.autoConvActive = true;
    this.autoConvIndex = 0;
    this.currentPage = 1;
    this.chatMessages = [
      { role: 'ai', text: '你好，我是你的情绪访谈员。检测到你的 ES3 波动值为 ' + this.es3 + '，今天感觉怎么样？' }
    ];
    // 预热 LLM（避免首次调用冷启动超时）
    try {
      velaclaw.ask({
        query: 'hello',
        success: () => {
          console.log('warmup done');
          setTimeout(() => { this.sendAutoMessage(); }, 1000);
        },
        fail: () => {
          console.log('warmup fail, continue anyway');
          setTimeout(() => { this.sendAutoMessage(); }, 1000);
        },
      });
    } catch (e) {
      console.log('warmup error, continue');
      setTimeout(() => { this.sendAutoMessage(); }, 1000);
    }
  },

  // 发送自动对话消息
  sendAutoMessage() {
    if (this.autoConvIndex >= this.autoConvSeq.length) {
      this.autoConvActive = false;
      // 对话结束后跳到播客页并自动生成播客
      setTimeout(() => {
        this.currentPage = 3;
        this.generatePodcast();
      }, 3000);
      return;
    }

    const msg = this.autoConvSeq[this.autoConvIndex];
    const fallbacks = [
      '听起来你今天压力不小。你的心率73和血氧97都在正常范围，但情绪感受和生理数据有时不完全一致。想和我聊聊是什么让你感到压力大吗？',
      '根据你的数据，心率73bpm处于健康范围，血氧97%正常，压力等级37属于中等偏低。整体生理状态不错，但你主观感受压力大，建议关注情绪调节。',
      '可以尝试4-7-8呼吸法：吸气4秒、屏息7秒、呼气8秒。另外接触自然光、播放轻柔白噪音也有帮助。适当运动也能释放压力。'
    ];
    const fbIdx = this.autoConvIndex;
    this.userMsg = msg;
    this.chatMessages.push({ role: 'user', text: msg });
    this.isAiThinking = true;
    let replyReceived = false;

    // 65秒超时后使用 fallback 回复
    setTimeout(() => {
      if (!replyReceived) {
        replyReceived = true;
        this.isAiThinking = false;
        this.chatMessages.push({ role: 'ai', text: fallbacks[fbIdx] || '(AI思考中...)' });
        this.autoConvIndex++;
        setTimeout(() => { this.sendAutoMessage(); }, 5000);
      }
    }, 65000);

    try {
      velaclaw.ask({
        query: msg,
        success: (res) => {
          if (replyReceived) return;
          replyReceived = true;
          this.isAiThinking = false;
          let reply = (res && res.reply) ? res.reply : fallbacks[fbIdx] || '(空回复)';
          if (reply.length < 20) reply = fallbacks[fbIdx] || reply;
          this.chatMessages.push({ role: 'ai', text: reply });
          this.autoConvIndex++;
          setTimeout(() => { this.sendAutoMessage(); }, 5000);
        },
        fail: (data, code) => {
          if (replyReceived) return;
          replyReceived = true;
          this.isAiThinking = false;
          this.chatMessages.push({ role: 'ai', text: fallbacks[fbIdx] || 'AI 回复失败 (code: ' + code + ')' });
          this.autoConvIndex++;
          setTimeout(() => { this.sendAutoMessage(); }, 5000);
        },
      });
    } catch(e) {
      if (replyReceived) return;
      replyReceived = true;
      this.isAiThinking = false;
      this.chatMessages.push({ role: 'ai', text: fallbacks[fbIdx] || 'AI 调用异常: ' + e });
      this.autoConvIndex++;
      setTimeout(() => { this.sendAutoMessage(); }, 5000);
    }
  },

  // 自动生成播客内容
  generatePodcast() {
    this.podcastText = '正在生成播客内容...';
    const query = '用户心率73血氧97压力37，自述心情不好压力大，AI建议4-7-8呼吸法放松。请基于这些信息生成一段播客风格叙事文本，80字以内，温暖治愈语调。';
    try {
      velaclaw.ask({
        query: query,
        success: (res) => {
          if (res && res.reply) {
            this.podcastText = res.reply;
          } else {
            this.podcastText = '播客生成失败，请重试';
          }
        },
        fail: (data, code) => {
          console.log('podcast gen fail, code:', code);
          this.podcastText = '播客生成失败 (code: ' + code + ')';
        },
      });
    } catch(e) {
      console.log('podcast gen error:', e);
      this.podcastText = '播客生成异常: ' + e;
    }
  },

  onDestroy() {
    if (this.timer) clearInterval(this.timer);
    this.unsubscribeHealth();
  },

  // 时钟更新
  updateTime() {
    const d = new Date();
    const h = String(d.getHours()).padStart(2, '0');
    const m = String(d.getMinutes()).padStart(2, '0');
    const s = String(d.getSeconds()).padStart(2, '0');
    this.timeStr = `${h}:${m}:${s}`;
    const week = ['日','一','二','三','四','五','六'][d.getDay()];
    this.dateStr = `${d.getFullYear()}年${d.getMonth()+1}月${d.getDate()}日 周${week}`;
  },

  // 获取最近一次健康数据（冷启动补一帧）
  getRecentHealth() {
    try {
      health.getRecentSamples({
        dataTypes: [
          health.DATA_TYPES.HEART_RATE,
          health.DATA_TYPES.SPO2,
          health.DATA_TYPES.STRESS,
        ],
        success: (list) => {
          if (list && list.length > 0) {
            list.forEach((item) => {
              if (item.dataType === health.DATA_TYPES.HEART_RATE && item.data && item.data.value) {
                this.hr = item.data.value;
                this.saveHealthData('hr', item.data.value);
              } else if (item.dataType === health.DATA_TYPES.SPO2 && item.data && item.data.value) {
                this.spo2 = item.data.value;
                this.saveHealthData('spo2', item.data.value);
              } else if (item.dataType === health.DATA_TYPES.STRESS && item.data && item.data.value) {
                this.stress = item.data.value;
                this.saveHealthData('stress', item.data.value);
              }
            });
          }
        },
        fail: (data, code) => {
          console.log('getRecentSamples fail, code:', code);
        },
      });
    } catch(e) {
      console.log('getRecentSamples error:', e);
    }
  },

  // 健康数据订阅
  subscribeHealth() {
    try {
      health.subscribeSample({
        dataType: health.DATA_TYPES.HEART_RATE,
        callback: (sample) => {
          if (sample && sample.value) {
            this.hr = sample.value;
            this.saveHealthData('hr', sample.value);
          }
        },
        fail: (data, code) => {
          console.log('HR subscribe fail, code:', code);
        },
      });
      health.subscribeSample({
        dataType: health.DATA_TYPES.SPO2,
        callback: (sample) => {
          if (sample && sample.value) {
            this.spo2 = sample.value;
            this.saveHealthData('spo2', sample.value);
          }
        },
        fail: (data, code) => {
          console.log('SPO2 subscribe fail, code:', code);
        },
      });
      health.subscribeSample({
        dataType: health.DATA_TYPES.STRESS,
        callback: (sample) => {
          if (sample && sample.value) {
            this.stress = sample.value;
            this.saveHealthData('stress', sample.value);
          }
        },
        fail: (data, code) => {
          console.log('STRESS subscribe fail, code:', code);
        },
      });
    } catch(e) {
      console.log('subscribeHealth error:', e);
    }
  },

  unsubscribeHealth() {
    try {
      health.unsubscribeSample({ dataType: health.DATA_TYPES.HEART_RATE });
      health.unsubscribeSample({ dataType: health.DATA_TYPES.SPO2 });
      health.unsubscribeSample({ dataType: health.DATA_TYPES.STRESS });
    } catch(e) {
      console.log('unsubscribeHealth error:', e);
    }
  },

  // 拦截返回键 — 不退出应用
  onBack() {
    if (this.currentPage > 0) {
      this.currentPage = 0;
      return true;
    }
    return false;
  },

  // 导航按钮
  goNext() {
    if (this.currentPage < 4) {
      this.currentPage++;
    }
  },
  goPrev() {
    if (this.currentPage > 0) {
      this.currentPage--;
    }
  },

  // 页1：点击指标卡片
  onTapMetric(type) {
    // 点击卡片刷新ES3值（模拟情绪波动）
    var oldEs3 = this.es3;
    this.es3 = Math.floor(Math.random() * 50) + 30;
    this.checkVibrate(oldEs3, this.es3);
  },

  // 情绪峰值震动提醒：从<30(平静)或30-49(微波澜)跳到≥70(情绪峰值)时短震动
  checkVibrate(oldVal, newVal) {
    var now = Date.now();
    var COOLDOWN = 5 * 60 * 1000; // 5分钟冷却
    if (now - this.lastVibrateTime < COOLDOWN) return;
    var oldLevel = oldVal < 30 ? 0 : (oldVal < 50 ? 1 : (oldVal < 70 ? 2 : 3));
    var newLevel = newVal < 30 ? 0 : (newVal < 50 ? 1 : (newVal < 70 ? 2 : 3));
    if (oldLevel <= 1 && newLevel >= 3) {
      try {
        var vib = $app_require$("@app-module/system.vibrator");
        if (vib && vib.default) {
          vib.default.vibrate({ mode: 'short' });
        } else if (vib && vib.vibrate) {
          vib.vibrate({ mode: 'short' });
        }
        this.lastVibrateTime = now;
      } catch (e) {
        console.log('vibrate not available:', e);
      }
    }
  },

  // 页2：对话输入
  onInputFocus() {
    // AIoT-IDE 模拟器可点击，但 VM VNC 不可点击 — 自动对话序列覆盖此场景
  },

  onInputChange(e) {
    this.inputText = e.value || '';
  },

  // 发送消息并调用 AI
  onSendMsg() {
    const msg = this.inputText;
    if (!msg) return;

    this.userMsg = msg;
    this.chatMessages.push({ role: 'user', text: msg });
    this.inputText = '';
    this.isAiThinking = true;

    try {
      velaclaw.ask({
        query: msg,
        success: (res) => {
          this.isAiThinking = false;
          if (res && res.reply) {
            this.chatMessages.push({ role: 'ai', text: res.reply });
          } else {
            this.chatMessages.push({ role: 'ai', text: '抱歉，我没有理解你的意思。' });
          }
        },
        fail: (data, code) => {
          this.isAiThinking = false;
          console.log('velaclaw ask fail, code:', code);
          let errMsg;
          if (code === 203) {
            errMsg = '当前设备不支持 AI 能力。';
          } else if (code === 1000) {
            errMsg = 'AI 服务暂不可用，请稍后重试。';
          } else if (code === 1001) {
            errMsg = '对话内容被拒绝，请换个话题。';
          } else {
            errMsg = 'AI 回复失败（code: ' + code + '）';
          }
          this.chatMessages.push({ role: 'ai', text: errMsg });
        },
      });
    } catch(e) {
      this.isAiThinking = false;
      this.chatMessages.push({ role: 'ai', text: 'AI 调用异常：' + e });
    }
  },

  onVoiceInput() {
    this.chatMessages.push({ role: 'ai', text: '语音输入功能待接入，请使用自动对话演示' });
  },

  // 页4：播客交互
  onPlayPodcast() {
    this.isPlaying = !this.isPlaying;
  },

  onDeletePodcast() {
    this.podcastText = '';
  },

  // 页5：趋势tab切换
  onSwitchTab(tab) {
    this.activeTab = tab;
    if (tab === 'hr') {
      this.chartData = [
        { date: '09-11', height: 78, style: { height: '78px' } },
        { date: '09-12', height: 82, style: { height: '82px' } },
        { date: '09-13', height: 71, style: { height: '71px' } },
        { date: '09-14', height: 88, style: { height: '88px' } },
        { date: '09-15', height: 75, style: { height: '75px' } },
        { date: '09-16', height: 80, style: { height: '80px' } },
        { date: '09-17', height: 73, style: { height: '73px' } },
      ];
      this.stats = { min: '71bpm', max: '88bpm', avg: '78.1bpm' };
    } else if (tab === 'stress') {
      this.chartData = [
        { date: '09-11', height: 42, style: { height: '42px' } },
        { date: '09-12', height: 38, style: { height: '38px' } },
        { date: '09-13', height: 55, style: { height: '55px' } },
        { date: '09-14', height: 47, style: { height: '47px' } },
        { date: '09-15', height: 35, style: { height: '35px' } },
        { date: '09-16', height: 40, style: { height: '40px' } },
        { date: '09-17', height: 37, style: { height: '37px' } },
      ];
      this.stats = { min: '35', max: '55', avg: '42.0' };
    } else {
      this.chartData = [
        { date: '09-11', height: 97, style: { height: '97px' } },
        { date: '09-12', height: 96, style: { height: '96px' } },
        { date: '09-13', height: 98, style: { height: '98px' } },
        { date: '09-14', height: 95, style: { height: '95px' } },
        { date: '09-15', height: 97, style: { height: '97px' } },
        { date: '09-16', height: 96, style: { height: '96px' } },
        { date: '09-17', height: 97, style: { height: '97px' } },
      ];
      this.stats = { min: '95%', max: '98%', avg: '96.6%' };
    }
  },

  // 同步渲染趋势图（从内存historyData取最近7天，确保立即可见）
  renderChart(tab) {
    var arr = this.historyData[tab] || [];
    if (arr.length === 0) return;
    var recent = arr.length > 7 ? arr.slice(arr.length - 7) : arr;
    var chartData = recent.map(function(item) {
      return { date: item.date, height: item.value };
    });
    var values = recent.map(function(item) { return item.value; });
    var min = Math.min.apply(null, values);
    var max = Math.max.apply(null, values);
    var avg = (values.reduce(function(a, b) { return a + b; }, 0) / values.length).toFixed(1);
    var suffix = tab === 'hr' ? 'bpm' : (tab === 'spo2' ? '%' : '');
    this.chartData = chartData;
    this.stats = {
      min: min + suffix,
      max: max + suffix,
      avg: avg + suffix
    };
  },

  // 初始化30天模拟历史数据（同步执行，onReady后立即可见）
  init30DayData() {
    var types = ['hr', 'spo2', 'stress'];
    var defaults = { hr: 73, spo2: 97, stress: 37 };
    var variances = { hr: 18, spo2: 2, stress: 15 };
    var now = new Date();
    for (var t = 0; t < types.length; t++) {
      var type = types[t];
      var base = defaults[type];
      var v = variances[type];
      var arr = [];
      for (var i = 29; i >= 0; i--) {
        var d = new Date(now.getTime() - i * 86400000);
        var mm = (d.getMonth() + 1 < 10 ? '0' : '') + (d.getMonth() + 1);
        var dd = (d.getDate() < 10 ? '0' : '') + d.getDate();
        // 加入趋势波动，模拟真实变化
        var trend = Math.sin(i / 5) * v * 0.5;
        var noise = (Math.random() - 0.5) * v;
        var val = Math.round(base + trend + noise);
        if (type === 'spo2') {
          if (val > 100) val = 100;
          if (val < 90) val = 90;
        } else if (type === 'hr') {
          if (val < 55) val = 55;
          if (val > 120) val = 120;
        } else if (type === 'stress') {
          if (val < 10) val = 10;
          if (val > 75) val = 75;
        }
        arr.push({ date: mm + '-' + dd, value: val });
      }
      this.historyData[type] = arr;
    }
  },

  // 保存健康数据（更新内存 + 异步写入storage）
  saveHealthData(type, value) {
    var now = new Date();
    var mm = (now.getMonth() + 1 < 10 ? '0' : '') + (now.getMonth() + 1);
    var dd = (now.getDate() < 10 ? '0' : '') + now.getDate();
    var today = mm + '-' + dd;
    var arr = this.historyData[type] || [];
    // 同一天更新，不同天追加
    var found = false;
    for (var i = 0; i < arr.length; i++) {
      if (arr[i].date === today) {
        arr[i].value = value;
        found = true;
        break;
      }
    }
    if (!found) {
      arr.push({ date: today, value: value });
      if (arr.length > 30) arr = arr.slice(arr.length - 30);
      this.historyData[type] = arr;
    }
    // 刷新当前tab图表
    if (this.activeTab === type) {
      this.renderChart(type);
    }
    // 异步写入storage持久化
    try {
      var keyMap = { hr: 'history_hr', spo2: 'history_spo2', stress: 'history_stress' };
      var key = keyMap[type];
      storage.set({
        key: key,
        value: JSON.stringify(arr),
        fail: function() {
          console.log('saveHealthData storage set fail for', key);
        }
      });
    } catch(e) {
      console.log('saveHealthData error:', e);
    }
  },

  // 从storage同步历史数据（有则覆盖内存数据，没有则用内置30天数据）
  syncFromStorage() {
    var types = ['hr', 'spo2', 'stress'];
    var self = this;
    types.forEach(function(type) {
      try {
        var keyMap = { hr: 'history_hr', spo2: 'history_spo2', stress: 'history_stress' };
        var key = keyMap[type];
        storage.get({
          key: key,
          success: function(data) {
            if (data && data.value) {
              try {
                var arr = JSON.parse(data.value);
                if (arr && arr.length > 0) {
                  self.historyData[type] = arr;
                  if (type === self.activeTab) {
                    self.renderChart(type);
                  }
                }
              } catch(e) {
                console.log('syncFromStorage parse error for', key);
              }
            }
          },
          fail: function() {
            console.log('syncFromStorage get fail for', key);
          }
        });
      } catch(e) {
        console.log('syncFromStorage error:', e);
      }
    });
  },
}
</script>
