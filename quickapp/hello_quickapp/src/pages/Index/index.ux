          <text class="stat-value">{{stats.max}}</text>
        </div>
        <div class="stat-card">
          <text class="stat-label">Avg</text>
          <text class="stat-value">{{stats.avg}}</text>
        </div>
      </div>
      <div class="nav-bar">
        <div class="nav-btn nav-down" onclick="goPrev">
          <text class="nav-arrow">v</text>
        </div>
